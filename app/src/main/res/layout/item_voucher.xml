<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/primary_light"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:textColor="@color/primary_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Diskon 20% Sata Andagi" />

            <TextView
                android:id="@+id/tvPointCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_light"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="100 Poin" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvVoucherDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Potongan 20% untuk semua varian Sata Andagi di Cafe Sobremesa." />

        <TextView
            android:id="@+id/tvVoucherCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1A27AE60"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#27AE60"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Kode: SOBREMESA20"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnRedeemVoucher"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:text="Tukarkan Poin"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
