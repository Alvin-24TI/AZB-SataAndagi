<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    tools:context=".fragments.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo polos -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/logo" />

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:text="@string/welcome"
                android:textColor="@color/primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Seksi info polos: judul + garis + teks, tanpa card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:text="Informasi Cafe Sobremesa"
                android:textColor="@color/primary_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/primary_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:lineSpacingExtra="4dp"
                android:text="Sobremesa Sata Andagi App menyajikan informasi lengkap tentang kuliner khas Okinawa. Jelajahi katalog menu cafe dan fitur membership di bawah ini!"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Menu Catalog Button (MOVED TO HOME) -->
            <Button
                android:id="@+id/btnMenu"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="🍩 Menu Makanan &amp; Minuman"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <Button
                android:id="@+id/btnMemberQr"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="📱 Kartu &amp; QR Code"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <Button
                android:id="@+id/btnScanQr"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="📷 Scan QR Code"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <Button
                android:id="@+id/btnVouchers"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="🪙 Poin &amp; Voucher Diskon"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
