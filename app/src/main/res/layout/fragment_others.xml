<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    tools:context=".fragments.OthersFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header polos: judul + teks, tanpa card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:text="Fitur &amp; Informasi Lainnya"
                android:textColor="@color/primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:lineSpacingExtra="4dp"
                android:text="Pilih menu di bawah ini untuk melihat fitur tambahan Sobremesa Sata Andagi App:"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/primary_light" />

            <!-- Register Membership Button (MOVED TO LAINNYA) -->
            <Button
                android:id="@+id/btnRegisterMembership"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="@string/btn_register_membership"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <!-- View Member List Button (MOVED TO LAINNYA) -->
            <Button
                android:id="@+id/btnMemberList"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="Lihat Member Terdaftar"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <!-- Developer Profile Button (MOVED TO LAINNYA) -->
            <Button
                android:id="@+id/btnDeveloperProfile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="@string/btn_developer_profile"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <!-- Detail Snack Button -->
            <Button
                android:id="@+id/btnDetails"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="@string/btn_detail"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/primary_light" />

            <!-- YouTube Button -->
            <Button
                android:id="@+id/btnYouTube"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="start|center_vertical"
                android:text="@string/btn_youtube"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
